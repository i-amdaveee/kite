# Copy to .env and fill in. Never commit .env.

# Deployer key. Used ONLY by forge script for deploys. Keep it out of the repo.
# It needs a small amount of native USDC on Arc for gas.
PRIVATE_KEY=

# Arc testnet RPC
ARC_TESTNET_RPC_URL=

# Arc testnet chain id
ARC_TESTNET_CHAIN_ID=

# Deployer address, optional, for sanity checks in scripts
DEPLOYER_ADDRESS=

# Arc mainnet RPC. Left blank on purpose until Phase 6, and only Davee enables it.
ARC_MAINNET_RPC_URL=

# Arc mainnet chain id
ARC_MAINNET_CHAIN_ID=

# Contract address once deployed, used by the frontend and the agent script.
PUBLIC_AGENT_BUDGET_ADDRESS=

# Block explorer base URL for the chain you deployed to.
ARC_EXPLORER_URL=