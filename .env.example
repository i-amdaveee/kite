# Copy to .env and fill in. Never commit .env.
#
# NO PRIVATE KEY IN THIS FILE. Deploys use the encrypted Foundry keystore at
# ~/.foundry/keystores/, so scripts run with:
#   forge script ... --keystore deployer --broadcast
# and forge prompts for the password interactively. The key is never written to
# disk in plaintext. Do not add a PRIVATE_KEY line here.

# Arc testnet RPC and chain id.
# Verified against docs.arc.io: chain id confirmed live via eth_chainId (0x4cef52).
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.io
ARC_TESTNET_CHAIN_ID=5042002

# Keystore account name (the file under ~/.foundry/keystores/).
DEPLOYER_ACCOUNT_NAME=deployer

# Deployer address, used for read-only balance sanity checks before deploying.
# Needs a small amount of native USDC on Arc testnet for gas.
DEPLOYER_ADDRESS=

# Arc mainnet RPC and chain id. Left blank on purpose until Phase 6, and only
# Davee enables it. The mainnet deploy script also asserts chain id 5042 and
# refuses to run without an explicit --rpc-url, so it cannot fire by accident.
#
# NEVER put a provider API key in THIS file. This template is committed to git.
# If you use a keyed RPC provider, the key belongs in .env (gitignored) only.
ARC_MAINNET_RPC_URL=
ARC_MAINNET_CHAIN_ID=5042

# Contract address once deployed, used by the frontend and the agent script.
PUBLIC_AGENT_BUDGET_ADDRESS=

# Block explorer base URL for the chain you deployed to.
ARC_EXPLORER_URL=https://explorer.testnet.arc.io